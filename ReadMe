#####
###       Migrations                  ############################## 

# 1. Initialiser Aerich (à faire une seule fois)
aerich init -t core.config.TORTOISE_ORM

# 2. Créer la première migration
aerich init-db

# 3. Quand tu modifies tes modèles
aerich migrate --name "add_deliverer_referral_system"

# 4. Appliquer les migrations à la base
aerich upgrade

# 5. (optionnel) Revenir en arrière
aerich downgrade

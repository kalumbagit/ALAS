# --- Application ---
APP_NAME="My FastAPI App"
APP_ENV=development
APP_PORT=8000
APP_VERSION=1.0.0
APP_TYPE=api
API_VERSION=v1
DEBUG=True

# --- Database PostgreSQL ---
DB_HOST=172.19.0.2          # Utiliser le nom du service Docker si vous etes dans un conteneur sinon utiliser l'IP du container en externe de containair
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=postgres
DB_PASSWORD=secret

# --- Redis ---
REDIS_HOST=172.19.0.3          # Nom du service Docker
REDIS_PORT=6379
REDIS_DB=0                # Base Redis par défaut

# --- Security ---
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3600
REFRESH_TOKEN_EXPIRE_DAYS=7


# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# MinIO
MINIO_ENDPOINT=172.19.0.5:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_SECURE=False
MINIO_BUCKET_DELIVERER_IDENTITY=deliverer-docs
MINIO_BUCKET_MERCHANT_DOCS=merchant-docs
MINIO_BUCKET_USER_AVATARS=user-avatars

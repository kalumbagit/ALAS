# --- Application ---
APP_NAME="My FastAPI App"
APP_ENV=development
APP_PORT=8000
DEBUG=True

# --- Database PostgreSQL ---
DB_HOST=postgres          # Utiliser le nom du service Docker
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=postgres
DB_PASSWORD=secret

# --- Redis ---
REDIS_HOST=redis          # Nom du service Docker
REDIS_PORT=6379
REDIS_DB=0                # Base Redis par défaut

# --- Security ---
JWT_SECRET=myjwtsecret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Misc ---
DEBUG=True
